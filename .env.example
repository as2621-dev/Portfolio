# Folio Pop portfolio — environment template.
# Copy to `.env.local` (git-ignored) and fill in real values. No secrets are
# required for the scaffold; these are placeholders for later phases.

# Public base URL of the deployed site (used for metadata / canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: endpoint the contact form posts to (e.g. a Formspree / Resend route).
# CONTACT_FORM_ENDPOINT=""
